{
  "name": "@mm-agent/opencode",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mm-agent-opencode": "./dist/install.js"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 tests/plugin-spike.test.ts",
    "build": "tsc -p tsconfig.json",
    "test:runtime": "cross-env MM_AGENT_RUNTIME=1 tsx --test --test-concurrency=1 --test-name-pattern=^runtime: tests/plugin-spike.test.ts",
    "golden": "node -e \"console.error('Golden Case belongs to PLAN Step 7 and is unavailable in Step 1'); process.exit(1)\""
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "rubrics",
    "runtime",
    "knowledge",
    "templates/cumcmthesis",
    "templates/mcmthesis",
    "schemas"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "1.18.2"
  },
  "devDependencies": {
    "@types/node": "24.0.13",
    "cross-env": "10.0.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
